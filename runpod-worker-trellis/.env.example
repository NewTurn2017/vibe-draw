# =============================================================================
# RunPod Serverless TRELLIS worker — environment variables
# =============================================================================
# These values are consumed by handler.py at runtime. Configure them in TWO
# places:
#   1) RunPod endpoint console → Environment Variables (production)
#   2) (Optional) a local .env file next to docker-compose / docker run
#      command if you want to smoke-test the container on your own GPU
# =============================================================================

# ---- TRELLIS model source -------------------------------------------------
# HuggingFace repo id for TRELLIS image-to-3D weights. The Dockerfile already
# pre-downloads this at build time; override only if you fork the weights.
TRELLIS_REPO=jetx/trellis-image-large

# If the HF repo is gated (you accepted terms on the HF page), paste a read
# token here so the build/runtime can fetch the weights.
HUGGINGFACE_HUB_TOKEN=

# ---- Cloudflare R2 object storage -----------------------------------------
# Required to serve the resulting .glb to the frontend. If left blank, the
# handler falls back to returning the .glb as base64 in the response — fine
# for smoke tests, not for real traffic.

# Found in: Cloudflare dashboard → R2 → "Overview" → S3 API endpoint.
# Format:   https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Bucket the worker writes into. Create it in the R2 console first.
R2_BUCKET=

# R2 API token credentials (Manage R2 API Tokens → "Create API Token"
# → permission: Object Read & Write, scope: just the bucket above).
# These are shown exactly once at token creation time — copy immediately.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# (Optional) Public base URL for the bucket if you bind a custom domain or
# enable the bucket's r2.dev subdomain (e.g. https://pub-xxxx.r2.dev or
# https://assets.your-domain.com). When set, handler.py returns
# `<R2_PUBLIC_BASE_URL>/trellis/<job_id>.glb` directly instead of a
# presigned URL. Leave blank to fall back to a time-limited presigned URL.
R2_PUBLIC_BASE_URL=

# Presigned URL lifetime in seconds (default 24h). Only used when
# R2_PUBLIC_BASE_URL is blank.
R2_URL_TTL=86400
