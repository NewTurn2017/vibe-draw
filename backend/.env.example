# Core provider keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# RunPod Serverless endpoint for self-hosted TRELLIS (image-to-3D)
RUNPOD_API_KEY=
RUNPOD_TRELLIS_ENDPOINT_ID=

# Cloudflare R2 — backend uploads the base64 GLB returned by the WeAreBraveLabs
# TRELLIS.2 worker so the frontend can fetch a URL instead of a multi-MB blob.
# Reuse the SAME bucket/credentials as the worker .env (runpod-worker-trellis/.env).
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_URL_TTL=86400

# Model overrides (verify slugs against each provider's current docs)
GEMINI_CODE_MODEL=gemini-3-pro
GEMINI_PARSE_MODEL=gemini-3-flash-lite
OPENAI_PARSE_MODEL=gpt-5.4-nano
FLUX_MODEL=google/nano-banana
